# Servidor
PORT=3001

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/studio13?schema=public"
DIRECT_URL="postgresql://usuario:contrasena@localhost:5432/studio13?schema=public"

# Autenticación (mínimo 32 bytes)
JWT_SECRET="cambia-este-secreto-por-uno-de-al-menos-32-bytes"

# Orígenes permitidos separados por coma
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# URL del panel administrativo (se usa en los enlaces de recuperación)
ADMIN_URL="http://localhost:3002"

# Correo SMTP (necesario para enviar recuperaciones de contraseña)
SMTP_HOST="smtp.dominio.com"
SMTP_PORT=587
SMTP_USER="correo@dominio.com"
SMTP_PASS="contrasena-o-clave-de-aplicacion"
SMTP_FROM="Studio13 <correo@dominio.com>"

# Cloudinary (opcional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
